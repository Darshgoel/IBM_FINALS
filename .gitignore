# Dependencies
node_modules/
*/node_modules/
package-lock.json.bak

# Local one-off database/account inspection and demo seeding helpers
backend/_check_accounts.js
backend/_seed_test_partners.js

# Environment variables & secrets
.env
.env.*
!.env.example
*.env

# SQLite and local database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backend/database/*.db
backend/database/*.db-shm
backend/database/*.db-wal

# User uploads & runtime storage (preserve directory with .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor folders
