{"kind":"textbox","id":"sh/q5wjelsz","slideIndex":1,"position":{"left":83.38,"top":428.43,"width":1081.24,"height":89.44},"name":"Text 7","text":"FoodBridge connects verified donors, NGOs, food banks, recipients and recovery partners. It matches surplus with local demand, tracks handoffs, helps recipients find nearby access points and routes unsuitable food toward recovery.","geometry":"rect","style":{"fontSize":26.67,"typeface":"IBM Plex Sans","color":"#000000","alignment":"left"}}
